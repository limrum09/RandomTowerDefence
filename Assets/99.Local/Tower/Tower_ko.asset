  - m_Id: 23009046583
    m_Localized: "\uC6A9\uC758 \uBB34\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 23009046585
    m_Localized: "\uD3EC\uC2DD\uC790\uC758 \uB208"
    m_Metadata:
      m_Items: []
  - m_Id: 23009046576
    m_Localized: "\uC138\uC0C1\uC744 \uC6C0\uC9C1\uC774\uB294 \uD669\uAE08\uC758
      \uD328\uAD8C\uC774 \uC778\uAC04\uC758 \uC190\uB05D\uC5D0\uC11C \uB354\uC6B1
      \uAC15\uB825\uD558\uAC8C \uC694\uB3D9\uCE69\uB2C8\uB2E4.\\n\uC778\uAC04 \uD0C0\uC6CC\uB97C
      <color=#FF4545>[{0} / {1} / {2} / {3}]</color> \uAC1C \uC18C\uC720\uD558\uBA74\\n\uB77C\uC6B4\uB4DC
      \uC885\uB8CC \uC2DC \uC774\uC790\uC728\uC774 <color=#FF4545>[{4} / {5}  / {6}
      / {7}]%p</color> \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23009046578
    m_Localized: "\uC2E0\uBE44\uD55C \uC790\uC5F0\uC758 \uAE30\uC6B4\uC774 \uC815\uB839\uACFC
      \uC5D8\uD504\uB4E4\uC744 \uD558\uB098\uB85C \uC5F0\uACB0\uD569\uB2C8\uB2E4.\\n\uC5D8\uD504
      \uD0C0\uC6CC \uBCF4\uC720: <color=#FF4545>[{0} / {1} / {2} / {3}]</color>\\n\uBAA8\uB4E0
      \uC5D8\uD504 \uD0C0\uC6CC \uACF5\uACA9\uB825 <color=#FF4545>[{4} / {5} / {6}
      / {7}]</color> \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 23009046580
    m_Localized: "\uB4DC\uC6CC\uD504\uC758 \uC815\uBC00\uD55C \uD0C0\uACA9\uC774
      \uC801\uC758 \uAC00\uC7A5 \uB2E8\uB2E8\uD55C \uBD80\uC704\uB97C \uD30C\uACE0\uB4ED\uB2C8\uB2E4.\\n\uB4DC\uC6CC\uD504
      \uD0C0\uC6CC \uBCF4\uC720: <color=#FF4545>[{0} / {1} / {2}]</color>\\n\uC801
      \uBC29\uC5B4\uB825 <color=#FF4545>[{3} / {4} / {5}]%</color> \uAC10\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 23009046582
    m_Localized: "\uAC70\uCE5C \uD3EC\uD6A8\uC640 \uD568\uAED8 \uC624\uD06C\uB4E4\uC758
      \uC555\uB3C4\uC801\uC778 \uBB34\uB825\uC774 \uC804\uC7A5\uC744 \uC9D3\uB204\uB985\uB2C8\uB2E4.\\n\uC624\uD06C
      \uD0C0\uC6CC \uBCF4\uC720: <color=#FF4545>[{0} / {1} / {2} / {3}]</color>\\n\uACF5\uACA9\uB825
      <color=#FF4545>[{4} / {5} / {6}]</color> \uC99D\uAC00\\n4\uB2E8\uACC4: \uACF5\uACA9
      \uC2DC <color=#45A2FF>\uC2AC\uB85C\uC6B0</color>(<color=#45A2FF>{8}</color>\uCD08
      \uB3D9\uC548, \uC801 \uC774\uB3D9\uC18D\uB3C4 <color=#FF4545>{7}%</color>\uAC10\uC18C)
      \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 23009046584
    m_Localized: "\uACE0\uB300 \uC6A9\uC758 \uAC08\uB77C\uC9C4 \uC778\uC790\uAC00
      \uC6A9\uC778\uB4E4\uC758 \uD608\uAD00 \uC18D\uC5D0\uC11C \uB728\uAC81\uAC8C
      \uC694\uB3D9\uCE69\uB2C8\uB2E4.\\n\uC6A9\uC778 \uD0C0\uC6CC \uBCF4\uC720: <color=#FF4545>[{0}
      / {1} / {2} / {3} / {4} / {5}]</color>\\n\uBAA8\uB4E0 \uC6A9\uC778 \uD0C0\uC6CC
      \uACF5\uACA9\uB825 <color=#FF4545>[{6} / {7} / {8} / {9} / {10} / {11}]</color>
      \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 23009046586
    m_Localized: "\uC5B4\uB460 \uC18D\uC5D0\uC11C\uB3C4 \uBC88\uB729\uC774\uB294
      \uC218\uC778\uC758 \uB208\uB3D9\uC790\uB294 \uACB0\uCF54 \uBA39\uC787\uAC10\uC744
      \uB193\uCE58\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\\n\uC218\uC778 \uD0C0\uC6CC \uBCF4\uC720:
      <color=#FF4545>[{0} / {1} / {2} / {3}]</color>\\n\uCE58\uBA85\uD0C0 \uD655\uB960
      <color=#FF4545>[{4} / {5} / {6} / {7}]%p</color> \uC99D\uAC00"
