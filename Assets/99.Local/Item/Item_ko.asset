      \uC608\uBE44\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23009046568
    m_Localized: "\uC0C1\uC810 \uD310\uB9E4 \uC2AC\uB86F\uC744 <color=#FF4545>[{0}\uCE78]</color>
