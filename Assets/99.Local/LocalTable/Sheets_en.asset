    m_Localized: Mana Barrier
    m_Metadata:
      m_Items: []
  - m_Id: 23009046598
    m_Localized: 'Creates a mana shield that absorbs {4} damage. (Cooldown: {1}s)'
    m_Metadata:
      m_Items: []
  - m_Id: 23009046599
    m_Localized: Guardian Field
    m_Metadata:
      m_Items: []
  - m_Id: 23009046600
    m_Localized: 'Grants allies within {3} range a shield that absorbs {4} damage
